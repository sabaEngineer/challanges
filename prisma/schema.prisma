generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  admin

  @@map("user_role")
}

model User {
  id                    String   @id @default(uuid())
  email                 String   @unique
  fullName              String?  @map("full_name")
  nameSetManually       Boolean  @default(false) @map("name_set_manually")
  avatarUrl             String?  @map("avatar_url") @db.Text
  googleId              String?  @map("google_id") @db.VarChar(255)
  username              String?  @unique
  role                  UserRole @default(user)
  topPerformerCount     Int      @default(0) @map("top_performer_count")
  pushToken             String?  @map("push_token") @db.Text
  pushNotificationsEnabled Boolean @default(false) @map("push_notifications_enabled")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at")

  challenges            Challenge[]            @relation("ChallengeCreator")
  challengeMembers      ChallengeMember[]
  notifications         Notification[]
  dailyCheckins         DailyCheckin[]
  reactions             PostReaction[]
  comments              PostComment[]
  commentLikes          CommentLike[]
  books                 Book[]                 @relation("BookOwner")
  borrowedBooks         Book[]                 @relation("BookBorrower")
  bookRequests          BookLendRequest[]      @relation("BookRequester")
  challengeReactions    ChallengeReaction[]
  challengeComments     ChallengeComment[]
  challengeCommentLikes ChallengeCommentLike[]
  bookComments          BookComment[]
  bookCommentLikes      BookCommentLike[]
  bookReactions         BookReaction[]
  feedback              Feedback[]
  topPerformerAwards    TopPerformerRecord[]
  notificationAnalytics NotificationAnalytics[]
  sessions              UserSession[]
  visitorTracks         VisitorTrack[]
  surveyResponses       SurveyResponse[]

  @@map("users")
}

enum ChallengeType {
  distance // running, walking, cycling (measured in km, m, steps)
  time     // meditation, workout, reading (minutes, hours)
  count    // push-ups, pages, reps
  yes_no   // wake up early, no sugar, no smoking

  @@map("challenge_type")
}

enum ChallengeUnit {
  reps     // push-ups, squats
  steps    // walking challenges
  km       // running, cycling
  meters   // short distance challenges
  minutes  // meditation, workouts
  hours    // reading, deep work
  pages    // reading challenges
  calories // nutrition challenges
  liters   // water intake
  workouts // gym session count
  meals    // meal count for nutrition challenges
  lari     // Georgian currency for savings challenges
  none     // for yes_no challenges

  @@map("challenge_unit")
}

enum MemberStatus {
  active
  left
  removed
  pending

  @@map("member_status")
}

enum StreakMode {
  strict   // Streak resets to 0 if a day is missed
  flexible // Streak doesn't break on missed days, just doesn't increase

  @@map("streak_mode")
}

enum NotificationType {
  challenge_invitation
  invitation_accepted
  invitation_rejected
  challenge_started
  challenge_ended
  member_checkin
  new_comment
  comment_reply
  new_reaction
  new_challenge
  book_request
  book_request_accepted
  book_request_rejected
  book_returned

  @@map("notification_type")
}

enum ReactionType {
  fire
  strong
  kudos
  not_bad
  heart
  smile

  @@map("reaction_type")
}

enum ChallengeFrequency {
  daily
  weekly
  custom

  @@map("challenge_frequency")
}

model Challenge {
  id          String             @id @default(uuid())
  title       String
  description String?            @db.Text
  imageUrl      String?            @map("image_url") @db.Text
  imagePosition String?            @map("image_position") // CSS object-position value like "50% 30%"
  startDate     DateTime           @map("start_date") @db.Date
  endDate     DateTime           @map("end_date") @db.Date
  frequency   ChallengeFrequency @default(daily)
  streakMode  StreakMode         @default(strict) @map("streak_mode")
  createdBy   String             @map("created_by")
  createdAt   DateTime           @default(now()) @map("created_at")

  creator       User                   @relation("ChallengeCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  requirements  ChallengeRequirement[]
  members       ChallengeMember[]
  notifications Notification[]
  dailyCheckins DailyCheckin[]
  reactions     ChallengeReaction[]
  comments      ChallengeComment[]

  @@map("challenges")
}

model ChallengeRequirement {
  id               String        @id @default(uuid())
  challengeId      String        @map("challenge_id")
  title            String?
  type             ChallengeType
  targetValue      Decimal?      @map("target_value") @db.Decimal
  unit             ChallengeUnit
  requirementGroup Int           @default(0) @map("requirement_group") // Group index for OR logic
  createdAt        DateTime      @default(now()) @map("created_at")

  challenge         Challenge           @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  dailyCheckinItems DailyCheckinItem[]

  @@map("challenge_requirements")
}

model ChallengeMember {
  id            String       @id @default(uuid())
  challengeId   String       @map("challenge_id")
  userId        String       @map("user_id")
  status        MemberStatus @default(pending)
  joinedAt      DateTime     @default(now()) @map("joined_at")
  leftAt        DateTime?    @map("left_at")
  currentStreak Int          @default(0) @map("current_streak")
  bestStreak    Int          @default(0) @map("best_streak")
  totalValue    Decimal      @default(0) @map("total_value") @db.Decimal

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@map("challenge_members")
}

model Notification {
  id          String           @id @default(uuid())
  userId      String           @map("user_id")
  type        NotificationType
  title       String
  message     String
  challengeId String?          @map("challenge_id")
  checkinId   String?          @map("checkin_id")
  bookId      String?          @map("book_id")
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now()) @map("created_at")

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge?    @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  checkin   DailyCheckin? @relation(fields: [checkinId], references: [id], onDelete: Cascade)
  book      Book?         @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model DailyCheckin {
  id           String   @id @default(uuid())
  challengeId  String   @map("challenge_id")
  userId       String   @map("user_id")
  checkinDate  DateTime @map("checkin_date") @db.Date
  note         String?  @db.Text
  imageUrl     String?  @map("image_url") @db.Text
  mediaUrls    Json?    @map("media_urls") // Array of { url: string, type: "image" | "video" }
  linkUrl      String?  @map("link_url") @db.Text // External URL (YouTube, Strava, etc.)
  isDone       Boolean  @default(false) @map("is_done")
  sharedToFeed Boolean  @default(false) @map("shared_to_feed")
  createdAt    DateTime @default(now()) @map("created_at")

  challenge     Challenge          @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         DailyCheckinItem[]
  reactions     PostReaction[]
  comments      PostComment[]
  notifications Notification[]

  @@unique([challengeId, userId, checkinDate])
  @@map("daily_checkins")
}

model DailyCheckinItem {
  id            String   @id @default(uuid())
  checkinId     String   @map("checkin_id")
  requirementId String   @map("requirement_id")
  value         Decimal? @db.Decimal
  isDone        Boolean  @default(false) @map("is_done")
  createdAt     DateTime @default(now()) @map("created_at")

  checkin     DailyCheckin         @relation(fields: [checkinId], references: [id], onDelete: Cascade)
  requirement ChallengeRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([checkinId, requirementId])
  @@map("daily_checkin_items")
}

model PostReaction {
  id        String       @id @default(uuid())
  checkinId String       @map("checkin_id")
  userId    String       @map("user_id")
  type      ReactionType
  createdAt DateTime     @default(now()) @map("created_at")

  checkin DailyCheckin @relation(fields: [checkinId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([checkinId, userId, type])
  @@map("post_reactions")
}

model PostComment {
  id        String   @id @default(uuid())
  checkinId String   @map("checkin_id")
  userId    String   @map("user_id")
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  checkin DailyCheckin  @relation(fields: [checkinId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes   CommentLike[]

  @@map("post_comments")
}

model CommentLike {
  id        String   @id @default(uuid())
  commentId String   @map("comment_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  comment PostComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@map("comment_likes")
}

// Challenge reactions (for new challenge announcements in feed)
model ChallengeReaction {
  id          String       @id @default(uuid())
  challengeId String       @map("challenge_id")
  userId      String       @map("user_id")
  type        ReactionType
  createdAt   DateTime     @default(now()) @map("created_at")

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId, type])
  @@map("challenge_reactions")
}

// Challenge comments (for new challenge announcements in feed)
model ChallengeComment {
  id          String   @id @default(uuid())
  challengeId String   @map("challenge_id")
  userId      String   @map("user_id")
  content     String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  challenge Challenge              @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes     ChallengeCommentLike[]

  @@map("challenge_comments")
}

model ChallengeCommentLike {
  id        String   @id @default(uuid())
  commentId String   @map("comment_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  comment ChallengeComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@map("challenge_comment_likes")
}

// Book ownership type
enum BookOwnershipType {
  physical      // User owns a physical copy - can be lent
  digital       // User owns digital/online version - just recommendation
  recommendation // User doesn't own but recommends - just recommendation

  @@map("book_ownership_type")
}

// Book lend request status
enum BookLendStatus {
  pending
  accepted
  rejected
  returned

  @@map("book_lend_status")
}

model Book {
  id            String            @id @default(uuid())
  title         String
  author        String
  description   String?           @db.Text
  coverUrl      String?           @map("cover_url") @db.Text
  language      String            @default("all") // "all", "en", "ka", "ru", etc.
  genres        String[]          @default([]) // Array of genre codes: fiction, drama, history, etc.
  ownershipType BookOwnershipType @map("ownership_type")
  userId        String            @map("user_id")
  lentToUserId  String?           @map("lent_to_user_id")
  lentAt        DateTime?         @map("lent_at")
  feedSharedAt  DateTime?         @map("feed_shared_at") // When this book was shown as daily recommendation in feed
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @default(now()) @updatedAt @map("updated_at")

  owner         User              @relation("BookOwner", fields: [userId], references: [id], onDelete: Cascade)
  borrower      User?             @relation("BookBorrower", fields: [lentToUserId], references: [id], onDelete: SetNull)
  requests      BookLendRequest[]
  notifications Notification[]
  comments      BookComment[]
  reactions     BookReaction[]

  @@map("books")
}

model BookLendRequest {
  id          String         @id @default(uuid())
  bookId      String         @map("book_id")
  requesterId String         @map("requester_id")
  status      BookLendStatus @default(pending)
  message     String?        @db.Text
  createdAt   DateTime       @default(now()) @map("created_at")
  respondedAt DateTime?      @map("responded_at")

  book      Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  requester User @relation("BookRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  @@map("book_lend_requests")
}

model BookComment {
  id        String   @id @default(uuid())
  bookId    String   @map("book_id")
  userId    String   @map("user_id")
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  book  Book              @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes BookCommentLike[]

  @@map("book_comments")
}

model BookCommentLike {
  id        String   @id @default(uuid())
  commentId String   @map("comment_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  comment BookComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@map("book_comment_likes")
}

model BookReaction {
  id        String       @id @default(uuid())
  bookId    String       @map("book_id")
  userId    String       @map("user_id")
  type      ReactionType
  createdAt DateTime     @default(now()) @map("created_at")

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bookId, userId, type])
  @@map("book_reactions")
}

// Feedback status
enum FeedbackStatus {
  pending
  reviewed
  planned
  completed
  rejected

  @@map("feedback_status")
}

// Feedback type
enum FeedbackType {
  bug
  feature
  improvement
  other

  @@map("feedback_type")
}

model Feedback {
  id        String         @id @default(uuid())
  userId    String         @map("user_id")
  type      FeedbackType
  title     String
  content   String         @db.Text
  status    FeedbackStatus @default(pending)
  adminNote String?        @map("admin_note") @db.Text
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("feedback")
}

model TopPerformerRecord {
  id            String   @id @default(uuid())
  date          DateTime @db.Date
  userId        String   @map("user_id")
  checkinCount  Int      @map("checkin_count")
  challengeCount Int     @map("challenge_count")
  score         Int
  isTie         Boolean  @default(false) @map("is_tie")
  createdAt     DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([date, userId])
  @@map("top_performer_records")
}

// Analytics: Notification modal interactions
model NotificationAnalytics {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  action    String   // "dismiss" | "enable" | "denied"
  device    String   // "ios" | "android" | "desktop"
  userAgent String?  @map("user_agent") @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_analytics")
}

// Analytics: User sessions for time tracking
model UserSession {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  device      String    // "ios" | "android" | "desktop"
  userAgent   String?   @map("user_agent") @db.Text
  startedAt   DateTime  @default(now()) @map("started_at")
  endedAt     DateTime? @map("ended_at")
  durationSec Int?      @map("duration_sec")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
}

// Analytics: Visitor tracking (device, OS, browser)
model VisitorTrack {
  id           String   @id @default(uuid())
  visitorId    String   @map("visitor_id") // Unique visitor identifier (stored in localStorage)
  userId       String?  @map("user_id") // Optional if user is logged in
  deviceType   String   @map("device_type") // "desktop" | "mobile" | "tablet"
  os           String   // "ios" | "android" | "windows" | "macos" | "linux" | "other"
  browser      String   // "chrome" | "safari" | "firefox" | "edge" | "samsung" | "other"
  userAgent    String?  @map("user_agent") @db.Text
  screenWidth  Int?     @map("screen_width")
  screenHeight Int?     @map("screen_height")
  language     String?
  referrer     String?  @db.Text
  page         String?  @db.Text // Page URL visited
  createdAt    DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([visitorId])
  @@index([createdAt])
  @@map("visitor_tracks")
}

// Survey response for notification preferences feedback
model SurveyResponse {
  id                    String   @id @default(uuid())
  visitorId             String   @map("visitor_id") // Can track even non-logged users
  userId                String?  @map("user_id")
  
  // Q1: Notification frequency preference
  notificationFrequency String?  @map("notification_frequency") // "yes" | "several_times" | "morning" | "evening" | "never"
  
  // Q2: Notification style preference
  notificationStyle     String?  @map("notification_style") // "simple_reminder" | "friendly_character" | "aggressive" | "other"
  notificationStyleOther String? @map("notification_style_other") @db.Text // If "other" selected
  
  // Q3: Best time for notifications
  preferredTime         String?  @map("preferred_time") // "morning" | "afternoon" | "evening" | "custom"
  customTime            String?  @map("custom_time") // If custom, specific time like "09:00"
  
  // Q4: What motivates you most
  motivationType        String?  @map("motivation_type") // "streaks" | "social_pressure" | "personal_goals" | "competition" | "other"
  
  // Q5: How often do you want challenge reminders
  reminderFrequency     String?  @map("reminder_frequency") // "every_challenge" | "once_daily" | "twice_daily" | "only_missed"
  
  // Additional feedback
  additionalFeedback    String?  @map("additional_feedback") @db.Text
  
  completed             Boolean  @default(false)
  userAgent             String?  @map("user_agent") @db.Text
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([visitorId])
  @@index([userId])
  @@map("survey_responses")
}
