generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  fullName  String?  @map("full_name")
  avatarUrl String?  @map("avatar_url") @db.Text
  googleId  String?  @map("google_id") @db.VarChar(255)
  username  String?  @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  challenges       Challenge[]       @relation("ChallengeCreator")
  challengeMembers ChallengeMember[]
  notifications    Notification[]
  dailyCheckins    DailyCheckin[]
  reactions        PostReaction[]
  comments         PostComment[]
  books            Book[]            @relation("BookOwner")
  borrowedBooks    Book[]            @relation("BookBorrower")
  bookRequests     BookLendRequest[] @relation("BookRequester")

  @@map("users")
}

enum ChallengeType {
  distance // running, walking, cycling (measured in km, m, steps)
  time     // meditation, workout, reading (minutes, hours)
  count    // push-ups, pages, reps
  yes_no   // wake up early, no sugar, no smoking

  @@map("challenge_type")
}

enum ChallengeUnit {
  reps     // push-ups, squats
  steps    // walking challenges
  km       // running, cycling
  meters   // short distance challenges
  minutes  // meditation, workouts
  hours    // reading, deep work
  pages    // reading challenges
  calories // nutrition challenges
  liters   // water intake
  workouts // gym session count
  lari     // Georgian currency for savings challenges
  none     // for yes_no challenges

  @@map("challenge_unit")
}

enum MemberStatus {
  active
  left
  removed
  pending

  @@map("member_status")
}

enum StreakMode {
  strict   // Streak resets to 0 if a day is missed
  flexible // Streak doesn't break on missed days, just doesn't increase

  @@map("streak_mode")
}

enum NotificationType {
  challenge_invitation
  invitation_accepted
  invitation_rejected
  challenge_started
  challenge_ended
  member_checkin
  new_comment
  comment_reply
  book_request
  book_request_accepted
  book_request_rejected
  book_returned

  @@map("notification_type")
}

enum ReactionType {
  fire
  strong
  kudos
  not_bad

  @@map("reaction_type")
}

model Challenge {
  id          String     @id @default(uuid())
  title       String
  description String?    @db.Text
  imageUrl    String?    @map("image_url") @db.Text
  startDate   DateTime   @map("start_date") @db.Date
  endDate     DateTime   @map("end_date") @db.Date
  streakMode  StreakMode @default(strict) @map("streak_mode")
  createdBy   String     @map("created_by")
  createdAt   DateTime   @default(now()) @map("created_at")

  creator       User                   @relation("ChallengeCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  requirements  ChallengeRequirement[]
  members       ChallengeMember[]
  notifications Notification[]
  dailyCheckins DailyCheckin[]

  @@map("challenges")
}

model ChallengeRequirement {
  id          String        @id @default(uuid())
  challengeId String        @map("challenge_id")
  title       String?
  type        ChallengeType
  targetValue Decimal?      @map("target_value") @db.Decimal
  unit        ChallengeUnit
  createdAt   DateTime      @default(now()) @map("created_at")

  challenge         Challenge           @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  dailyCheckinItems DailyCheckinItem[]

  @@map("challenge_requirements")
}

model ChallengeMember {
  id            String       @id @default(uuid())
  challengeId   String       @map("challenge_id")
  userId        String       @map("user_id")
  status        MemberStatus @default(pending)
  joinedAt      DateTime     @default(now()) @map("joined_at")
  leftAt        DateTime?    @map("left_at")
  currentStreak Int          @default(0) @map("current_streak")
  bestStreak    Int          @default(0) @map("best_streak")
  totalValue    Decimal      @default(0) @map("total_value") @db.Decimal

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@map("challenge_members")
}

model Notification {
  id          String           @id @default(uuid())
  userId      String           @map("user_id")
  type        NotificationType
  title       String
  message     String
  challengeId String?          @map("challenge_id")
  checkinId   String?          @map("checkin_id")
  bookId      String?          @map("book_id")
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now()) @map("created_at")

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  challenge Challenge?    @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  checkin   DailyCheckin? @relation(fields: [checkinId], references: [id], onDelete: Cascade)
  book      Book?         @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model DailyCheckin {
  id          String   @id @default(uuid())
  challengeId String   @map("challenge_id")
  userId      String   @map("user_id")
  checkinDate DateTime @map("checkin_date") @db.Date
  note        String?  @db.Text
  imageUrl    String?  @map("image_url") @db.Text
  isDone      Boolean  @default(false) @map("is_done")
  createdAt   DateTime @default(now()) @map("created_at")

  challenge     Challenge          @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         DailyCheckinItem[]
  reactions     PostReaction[]
  comments      PostComment[]
  notifications Notification[]

  @@unique([challengeId, userId, checkinDate])
  @@map("daily_checkins")
}

model DailyCheckinItem {
  id            String   @id @default(uuid())
  checkinId     String   @map("checkin_id")
  requirementId String   @map("requirement_id")
  value         Decimal? @db.Decimal
  isDone        Boolean  @default(false) @map("is_done")
  createdAt     DateTime @default(now()) @map("created_at")

  checkin     DailyCheckin         @relation(fields: [checkinId], references: [id], onDelete: Cascade)
  requirement ChallengeRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([checkinId, requirementId])
  @@map("daily_checkin_items")
}

model PostReaction {
  id        String       @id @default(uuid())
  checkinId String       @map("checkin_id")
  userId    String       @map("user_id")
  type      ReactionType
  createdAt DateTime     @default(now()) @map("created_at")

  checkin DailyCheckin @relation(fields: [checkinId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([checkinId, userId, type])
  @@map("post_reactions")
}

model PostComment {
  id        String   @id @default(uuid())
  checkinId String   @map("checkin_id")
  userId    String   @map("user_id")
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  checkin DailyCheckin @relation(fields: [checkinId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("post_comments")
}

// Book ownership type
enum BookOwnershipType {
  physical      // User owns a physical copy - can be lent
  digital       // User owns digital/online version - just recommendation
  recommendation // User doesn't own but recommends - just recommendation

  @@map("book_ownership_type")
}

// Book lend request status
enum BookLendStatus {
  pending
  accepted
  rejected
  returned

  @@map("book_lend_status")
}

model Book {
  id            String            @id @default(uuid())
  title         String
  author        String
  description   String?           @db.Text
  coverUrl      String?           @map("cover_url") @db.Text
  language      String            @default("all") // "all", "en", "ka", "ru", etc.
  genres        String[]          @default([]) // Array of genre codes: fiction, drama, history, etc.
  ownershipType BookOwnershipType @map("ownership_type")
  userId        String            @map("user_id")
  lentToUserId  String?           @map("lent_to_user_id")
  lentAt        DateTime?         @map("lent_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @default(now()) @updatedAt @map("updated_at")

  owner         User              @relation("BookOwner", fields: [userId], references: [id], onDelete: Cascade)
  borrower      User?             @relation("BookBorrower", fields: [lentToUserId], references: [id], onDelete: SetNull)
  requests      BookLendRequest[]
  notifications Notification[]

  @@map("books")
}

model BookLendRequest {
  id          String         @id @default(uuid())
  bookId      String         @map("book_id")
  requesterId String         @map("requester_id")
  status      BookLendStatus @default(pending)
  message     String?        @db.Text
  createdAt   DateTime       @default(now()) @map("created_at")
  respondedAt DateTime?      @map("responded_at")

  book      Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
  requester User @relation("BookRequester", fields: [requesterId], references: [id], onDelete: Cascade)

  @@map("book_lend_requests")
}
